# Copy to .env and adjust. All values are optional except ADMIN_API_KEY for admin endpoints.
APP_ENV=development
# SQLite for local dev. For production use Postgres, e.g. postgresql+psycopg://user:pass@host:5432/cyberheightsgym (pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./leads.db
# Comma-separated list of website origins allowed to call the API
CORS_ORIGINS=http://localhost:4176,http://127.0.0.1:4176,https://www.cyberheightsgym.example,https://cyberheightsgym.example
# Required to use the admin endpoints (list / update / export leads). Send as header: X-API-Key
ADMIN_API_KEY=change-me-to-a-long-random-string
# Max lead submissions per IP per minute
RATE_LIMIT_PER_MINUTE=10
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# --- Optional: email notification to the front desk / sales team on every new lead ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAILS=
# --- Optional: forward every lead as JSON to a CRM / Zapier / LeadSquared webhook ---
CRM_WEBHOOK_URL=
