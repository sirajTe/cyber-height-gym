{
  "name": "cyber-heights-gym-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static gym website \u2014 zero dependencies",
  "scripts": {
    "build": "node build.js",
    "serve": "node serve.js",
    "dev": "node build.js && node serve.js",
    "api": "cd ../backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8003",
    "api:setup": "cd ../backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && cp -n .env.example .env || true",
    "api:test": "cd ../backend && .venv/bin/python -m pytest -q"
  }
}
